   "source": [
    "# 02_sea_land_masks.ipynb\n",
    "\n",
    "Create sea / land masks and canonical basemap outputs.\n",
    "\n",
    "Outputs created in `data/`:\n",
    "- `sea_raster_bool.npy`\n",
    "- `final_sea_polygons.geojson`\n",
    "- `shore_points.npy` and `shore_points.geojson`\n",
    "- `basemap_rgb.npy` and `basemap_final.png`\n",
    "\n",
    "Rules used:\n",
    "- Pixel is sea IFF (DEM <= 0 AND not in NE land) OR inside Geofabrik water polygons.\n",
    "- Lakes (large inland water bodies) are not treated as sea for distance calculations (handled downstream).\n",
    "\n",
    "Run after `01_data_prep.ipynb`."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from pathlib import Path\n",
    "import numpy as np\n",
    "import rasterio\n",
    "from rasterio.features import rasterize, shapes as rio_shapes\n",
    "import geopandas as gpd\n",
    "from shapely.geometry import shape, box\n",
    "from shapely.ops import unary_union\n",
    "import matplotlib.pyplot as plt\n",
    "from matplotlib.colors import LinearSegmentedColormap\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "# Paths\n",
    "ROOT = Path('/home/jovyan/work/geoassetai_env')\n",
    "DATA = ROOT / 'data'\n",
    "DATA.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "DEM_TIF = DATA / 'merged_dem_rd_crop.tif'\n",
    "WATER_POLYS = DATA / 'all_geofabrik_water_polygons_clipped.geojson'\n",
    "NE_LAND_TIF = DATA / 'ne_land_mask.tif'  # optional raster\n",
    "\n",
    "SEA_RASTER_NPY = DATA / 'sea_raster_bool.npy'\n",
    "FINAL_SEA_POLY = DATA / 'final_sea_polygons.geojson'\n",
    "SHORE_POINTS_NPY = DATA / 'shore_points.npy'\n",
    "SHORE_POINTS_GEO = DATA / 'shore_points.geojson'\n",
    "BASMAP_RGB = DATA / 'basemap_rgb.npy'\n",
    "BASMAP_PNG = DATA / 'basemap_final.png'\n",
    "\n",
    "TARGET_CRS = 'EPSG:28992'\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 1) Load DEM and basic metadata\n",
    "if not DEM_TIF.exists():\n",
    "    raise FileNotFoundError(f\"DEM not found at: {DEM_TIF}. Run 01_data_prep or place canonical DEM into data/.\")\n",
    "\n",
    "with rasterio.open(DEM_TIF) as src:\n",
    "    dem = src.read(1)\n",
    "    dem_mask = src.read(1, masked=True).mask if hasattr(src.read(1, masked=True), 'mask') else np.zeros_like(dem, dtype=bool)\n",
    "    transform = src.transform\n",
    "    dem_crs = src.crs\n",
    "    h, w = src.height, src.width\n",
    "    bounds = src.bounds\n",
    "    res = src.res\n",
    "print('DEM loaded: shape', (h,w), 'CRS', dem_crs)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 2) Prepare NE land mask raster (if provided) or attempt to rasterize NE land vector\n",
    "land_mask = np.zeros((h,w), dtype=bool)\n",
    "if NE_LAND_TIF.exists():\n",
    "    with rasterio.open(NE_LAND_TIF) as src:\n",
    "        if (src.height, src.width) == (h, w) and src.transform == transform:\n",
    "            land_mask = src.read(1) != 0\n",
    "        else:\n",
    "            # reproject/resample NE land into DEM grid\n",
    "            from rasterio.warp import reproject, Resampling\n",
    "            dst = np.zeros((h,w), dtype=src.read(1).dtype)\n",
    "            reproject(\n",
    "                source=src.read(1),\n",
    "                destination=dst,\n",
    "                src_transform=src.transform, src_crs=src.crs,\n",
    "                dst_transform=transform, dst_crs=dem_crs,\n",
    "                resampling=Resampling.nearest\n",
    "            )\n",
    "            land_mask = dst != 0\n",
    "    print('Loaded NE land raster; land pixels:', int(land_mask.sum()))\n",
    "else:\n",
    "    # try a vector shapefile 'ne_land.shp' in data/\n",
    "    if (DATA / 'ne_land.shp').exists():\n",
    "        ne_land = gpd.read_file(DATA / 'ne_land.shp').to_crs(dem_crs)\n",
    "        land_mask = rasterize(((geom,1) for geom in ne_land.geometry), out_shape=(h,w), transform=transform, fill=0, all_touched=False).astype(bool)\n",
    "        print('Rasterized NE land vector; land pixels:', int(land_mask.sum()))\n",
    "    else:\n",
    "        print('No NE land input found; proceeding without NE land masking (recommended to provide Natural Earth land).')\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 3) Rasterize Geofabrik water polygons (if present) and compute DEM<=0 outside NE land\n",
    "poly_raster = np.zeros((h,w), dtype=bool)\n",
    "if Path(WATER_POLYS).exists():\n",
    "    water_polys = gpd.read_file(WATER_POLYS).to_crs(dem_crs)\n",
    "    if len(water_polys):\n",
    "        shapes_iter = ((geom, 1) for geom in water_polys.geometry)\n",
    "        poly_raster = rasterize(shapes_iter, out_shape=(h,w), transform=transform, fill=0, all_touched=False).astype(bool)\n",
    "    print('Water polygons rows:', len(water_polys) if 'water_polys' in locals() else 0, 'true pixels:', int(poly_raster.sum()))\n",
    "else:\n",
    "    print('Water polygons geojson not found:', WATER_POLYS)\n",
    "\n",
    "dem_le_zero = dem <= 0\n",
    "sea_by_dem = dem_le_zero & (~land_mask)\n",
    "print('DEM<=0 pixels:', int(dem_le_zero.sum()), 'sea_by_dem pixels:', int(sea_by_dem.sum()))\n",
    "\n",
    "# final sea raster = rasterized water polygons OR sea_by_dem\n",
    "final_sea = poly_raster | sea_by_dem\n",
    "np.save(SEA_RASTER_NPY, final_sea)\n",
    "print('Saved sea raster bool to:', SEA_RASTER_NPY, 'total sea pixels:', int(final_sea.sum()))\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 4) Convert final sea raster back to polygons (vector) and save final_sea_polygons.geojson\n",
    "polys = []\n",
    "px_area = abs(transform.a * transform.e)  # pixel area (m^2)\n",
    "for shp, val in rio_shapes(final_sea.astype('uint8'), transform=transform):\n",
    "    if val == 1:\n",
    "        poly = shape(shp)\n",
    "        # ignore tiny polygons (< 10 pixels)\n",
    "        if poly.area >= px_area * 10:\n",
    "            polys.append(poly)\n",
    "\n",
    "if polys:\n",
    "    sea_union = unary_union(polys)\n",
    "    sea_gdf = gpd.GeoDataFrame({'geometry':[sea_union]}, crs=dem_crs)\n",
    "    sea_gdf.to_file(FINAL_SEA_POLY, driver='GeoJSON')\n",
    "    print('Saved final sea polygons ->', FINAL_SEA_POLY)\n",
    "else:\n",
    "    print('No sea polygons extracted (unexpected).')\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 5) Sample shoreline points from NE land boundary intersecting DEM bbox\n",
    "dem_bbox_geom = box(float(bounds.left), float(bounds.bottom), float(bounds.right), float(bounds.top))\n",
    "\n",
    "# derive shoreline from NE land (preferred) else from sea polygon boundary\n",
    "if (DATA / 'ne_land.shp').exists():\n",
    "    ne_land = gpd.read_file(DATA / 'ne_land.shp').to_crs(dem_crs)\n",
    "    ne_union = unary_union(ne_land.geometry)\n",
    "    shore_geom = ne_union.boundary.intersection(dem_bbox_geom)\n",
    "else:\n",
    "    if 'sea_gdf' in locals() and not sea_gdf.empty:\n",
    "        land_like = unary_union([dem_bbox_geom])  # fallback\n",
    "        shore_geom = sea_gdf.geometry.unary_union.boundary.intersection(dem_bbox_geom)\n",
    "    else:\n",
    "        shore_geom = dem_bbox_geom.boundary\n",
    "\n",
    "def sample_line(line, spacing=200.0):\n",
    "    pts = []\n",
    "    if line.is_empty:\n",
    "        return pts\n",
    "    if line.geom_type == 'MultiLineString':\n",
    "        for seg in line.geoms:\n",
    "            L = seg.length\n",
    "            if L == 0:\n",
    "                continue\n",
    "            n = max(int(np.floor(L/spacing)), 1)\n",
    "            for i in range(n+1):\n",
    "                pts.append(seg.interpolate(min(i*spacing, L)))\n",
    "    else:\n",
    "        L = line.length\n",
    "        n = max(int(np.floor(L/spacing)), 1)\n",
    "        for i in range(n+1):\n",
    "            pts.append(line.interpolate(min(i*spacing, L)))\n",
    "    return pts\n",
    "\n",
    "shore_pts = sample_line(shore_geom, spacing=200.0)\n",
    "shore_coords = np.array([[p.x, p.y] for p in shore_pts]) if shore_pts else np.empty((0,2))\n",
    "np.save(SHORE_POINTS_NPY, shore_coords)\n",
    "print('Saved shore points numpy:', SHORE_POINTS_NPY, 'count:', shore_coords.shape[0])\n",
    "\n",
    "if shore_coords.shape[0] > 0:\n",
    "    pts = [box(0,0,0,0) for _ in range(0)]  # placeholder\n",
    "    # create GeoDataFrame of Points\n",
    "    from shapely.geometry import Point\n",
    "    shore_gdf = gpd.GeoDataFrame({'geometry':[Point(xy) for xy in shore_coords]}, crs=dem_crs)\n",
    "    shore_gdf.to_file(SHORE_POINTS_GEO, driver='GeoJSON')\n",
    "    print('Saved shore_points.geojson')\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 6) Create a basemap RGB where sea pixels are flat blue and land shows DEM-derived colouring + hillshade\n",
    "from matplotlib.colors import LinearSegmentedColormap\n",
    "\n",
    "rd_colors = ['#f8f4ee','#e0d6c8','#c8b080','#a98c63']\n",
    "cmap = LinearSegmentedColormap.from_list('basemap_rd', rd_colors)\n",
    "\n",
    "vmin, vmax = np.nanpercentile(dem, [2,98])\n",
    "dem_norm = np.clip((dem - vmin) / (vmax - vmin + 1e-9), 0, 1)\n",
    "rgb = cmap(dem_norm)[...,:3]\n",
    "\n",
    "# make sea flat pastel blue\n",
    "SEA_COLOR = np.array([166/255, 206/255, 227/255])\n",
    "rgb2 = rgb.copy()\n",
    "rgb2[final_sea] = SEA_COLOR\n",
    "\n",
    "# Save basemap RGB as uint8\n",
    "np.save(BASMAP_RGB, (rgb2*255).astype(np.uint8))\n",
    "\n",
    "# Quick PNG preview (oriented according to transform)\n",
    "rgb_plot = np.flipud(rgb2) if transform.e < 0 else rgb2\n",
    "plt.figure(figsize=(10,10))\n",
    "plt.imshow(rgb_plot, origin='lower')\n",
    "plt.axis('off')\n",
    "plt.title('Basemap preview (DEM + sea)')\n",
    "plt.savefig(BASMAP_PNG, dpi=200, bbox_inches='tight')\n",
    "plt.close()\n",
    "print('Saved basemap preview and numpy RGB: ', BASMAP_PNG, BASMAP_RGB)\n"
   ]
  },
